# Copy to /etc/deepseek-v4-flash.env, chmod 600, then fill in a real key.
# Generate one with:
#   printf 'VLLM_API_KEY=%s\n' "dsv4-$(python3 -c 'import secrets;print(secrets.token_urlsafe(36))')"
#
# WARNING: if VLLM_API_KEY is empty/unset, vLLM installs NO auth middleware at
# all and EVERY route is open on 0.0.0.0 -- silently, with nothing in the log.
VLLM_API_KEY=REPLACE_ME
